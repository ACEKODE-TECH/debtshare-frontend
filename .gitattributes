# Normalize line endings to LF in the repo and in every working tree.
# Without this, Windows checkouts get CRLF and `npm run format:check` fails
# locally on every file while passing in CI, where the checkout is LF.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.woff -text
*.woff2 -text

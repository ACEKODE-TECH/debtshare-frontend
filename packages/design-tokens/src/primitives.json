    "modifications": [
      "shadow.md, shadow.lg and shadow.lgAlt replaced with neutral, low-opacity slate-900 variants so the primary button's default/hover/pressed states stay chromatically consistent (see docs/design-system-components.md button spec). Every other value is untouched."
    ],
    "outputs": [
      "radius.device.* and shadow.device.* are excluded from the generated CSS and Tailwind theme: they belong to the presentation frame of the Claude Design mockup, not to the Debtshare product."
    ]

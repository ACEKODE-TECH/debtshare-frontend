{
  "name": "debtshare-frontend",
  "version": "0.1.0",
  "description": "Frontend de Debtshare: gastos compartidos, escaneo de tickets y dashboard de analiticas.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "msw:init": "msw init public --save",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5",
    "date-fns": "^4",
    "motion": "^12",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-router": "^7",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "globals": "^17",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "lint-staged": "^16.4.0",
    "msw": "^2",
    "postcss": "^8",
    "prettier": "^3",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "250 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/*.css",
      "limit": "50 kB",
      "gzip": true
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
